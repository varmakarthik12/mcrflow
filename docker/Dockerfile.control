# ==============================================================================
# MCRFlow Master Control Plane (Control Plane + Web Management UI + REST API)
# ==============================================================================

ARG GO_IMAGE=public.ecr.aws/docker/library/golang:1.23-alpine
ARG RUNTIME_IMAGE=public.ecr.aws/docker/library/alpine:3.20

# Stage 1: Build Go binary with embedded React assets
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS builder

ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /app
ENV GOTOOLCHAIN=auto

# Cache Go dependencies
COPY go.mod go.sum* ./
RUN go mod download

# Copy source and built React UI dist
COPY . .

RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags="-s -w" -o /bin/mcrflow-control ./cmd/mcrflow-control

# Stage 2: Runtime environment
FROM ${RUNTIME_IMAGE} AS runtime

RUN apk add --no-cache \
    ca-certificates \
    ffmpeg \
    tzdata \
    curl

WORKDIR /app
RUN mkdir -p /data /media

# Default volumes for persistent SQLite database and media
VOLUME ["/data", "/media"]

COPY --from=builder /bin/mcrflow-control /usr/local/bin/mcrflow-control

EXPOSE 3081

ENV MCRFLOW_PORT=3081 \
    MCRFLOW_DATA_DIR=/data \
    MCRFLOW_MEDIA_DIR=/media

ENTRYPOINT ["/usr/local/bin/mcrflow-control"]
